<div class="container fluid-container alert message">
  <p class="body">
    <% if (locals.message === ERROR) { %>
        Don't worry there's no <strong>error</strong> you've stumbled across a hidden easter egg!
    <% } %>

    <% if (locals.message && locals.title) { %>
        <em><%= title %></em> <strong><%= message %></strong> successfully!
    <% } %>
  </p>
  <span class="dismiss">&times;</span>
</div>
