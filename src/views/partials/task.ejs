<article
  class="card field-card"
  data-id="<%= task.id %>"
  data-title="<%= task.title %>"
  data-status="<%= task.status %>"
  data-start="<%= task.startDate ?? '' %>"
  data-end="<%= task.endDate ?? '' %>"
>
    <h3 class="title"><%= task.title %></h3>

  <div class="field-body">
    <div class="field">
      <span class="field-name">Status</span>

      <span
        class="field-value status status-<%= task.status.toLowerCase().replace(/\s+/g, '-') %>"
      >
        <%= task.status %>
      </span>
    </div>

    <div class="field">
      <span class="field-name">Start</span>

      <time class="field-value" datetime="<%= task.startDate ?? '' %>">
        <%= formatDate(task.startDate) %>
      </time>
    </div>

    <div class="field">
      <span class="field-name">End</span>

      <time class="field-value" datetime="<%= task.endDate ?? '' %>">
        <%= formatDate(task.endDate) %>
      </time>
    </div>
  </div>

  <div class="btn-group">
    <%- include("./taskButton", {
            mode: BUTTON_LABELS.edit,
        }) %>
    <button
      class="btn btn-danger"
      command="show-modal"
      commandfor="delete-dialog"
    >
      Delete
    </button>
  </div>
</article>
