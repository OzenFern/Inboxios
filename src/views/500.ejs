<%- include("partials/header"), { 
  pageTitle: "500 - Internal Server Error", stylesheet: "/css/pages/error.css"
} %>

<section class="error">
  <div class="container fluid-container">
    <span class="dot-badge surface-bg"><span class="dot danger-dot"></span>HTTP 500</span>
    <h2 class="glowing-heading">Task</h2>

    <div class="card field-card">
      <h3>Complete Request</h3>
      <div class="field-body">
        <div class="field">
          <span class="field-name">Status</span>

          <span class="icon-text status status-warning field-value">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="currentColor"
              class="bi bi-exclamation-triangle"
              viewBox="0 0 16 16"
            >
              <path
                d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057m1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z"
              />
              <path
                d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"
              />
            </svg>
            Failed
          </span>
        </div>

        <p class="sub-text-lg fs-200">
          <%= APP.NAME %> encountered an unexpected error while processing your
          request.
        </p>

        <p class="muted">
          If the problem persists, please report it on GitHub.
        </p>

        <div class="btn-group center mt-lg">
          <button id="retry-btn" class="btn btn-gradient btn-lg btn-primary">
            Retry
          </button>

          <a
            class="btn btn-gradient btn-lg btn-secondary"
            href="<%= ROUTES.HOME %>"
          >
            Return Home
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
